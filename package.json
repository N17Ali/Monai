{
  "name": "monai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply monai-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply monai-db --remote",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/react": "^4.0.110",
    "@base-ui/react": "^1.8.0",
    "@fontsource/vazirmatn": "latest",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "latest",
    "@jalali-js/react": "^0.4.2",
    "@tailwindcss/vite": "latest",
    "@tanstack/react-query": "^5.103.1",
    "ai": "^7.0.107",
    "class-variance-authority": "^0.7.1",
    "clsx": "latest",
    "drizzle-orm": "^0.45.2",
    "nuqs": "^2.10.1",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "latest",
    "tailwindcss": "latest",
    "three-dots": "^0.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.0",
    "shadcn": "^4.21.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
